# ==============================================================================
# DASAV CAR WASH - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a .env para desarrollo local:
#   cp .env.example .env
#
# Para producción en Railway, añade estas variables en la pestaña "Variables"
# de tu servicio. NUNCA subas tu archivo .env real al repositorio Git.
# ==============================================================================

# Entorno de ejecución: 'development' (local) | 'production' (Railway)
NODE_ENV=development

# Zona horaria del negocio. El arranque fuerza este mismo valor para evitar
# diferencias entre el equipo local y Railway.
TZ=America/Lima

# Puerto del servidor (en Railway se asigna automáticamente mediante $PORT)
PORT=3000

# Host de escucha ('127.0.0.1' en local, '0.0.0.0' en Railway/Docker)
HOST=127.0.0.1

# Ruta del archivo SQLite
# - Local: './data/carwash.db'
# - Railway con Volume montado en /data: '/data/carwash.db'
DATABASE_PATH=./data/carwash.db

# Credenciales para el primer arranque (solo se usan si la base de datos está vacía)
# Si la base de datos ya existe, usa "Administración > Seguridad" para cambiar la contraseña.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ejemplo_contrasena_super_segura_minimo_16_caracteres

# Secreto criptográfico para firma de cookies de sesión (genera una cadena aleatoria de 64 caracteres)
COOKIE_SECRET=ejemplo_cookie_secret_aleatorio_64_caracteres_hexadecimales_1234567890

# Confianza en cabeceras de proxy inverso (X-Forwarded-*).
# Mantén 'false' a menos que requieras explícitamente validar IPs a través de proxy.
TRUST_PROXY=false

# ==============================================================================
# INTEGRACIONES: OCR DE PLACAS Y CONSULTA SUNARP (OPCIONALES)
# ==============================================================================
# Token para consulta oficial de placas vehiculares en https://app.json.pe
JSON_PE_TOKEN=tu_token_de_json_pe_aqui

# Clave de Google Gemini API para OCR con visión artificial (gratuita en https://aistudio.google.com)
GEMINI_API_KEY=tu_clave_gemini_api_aqui

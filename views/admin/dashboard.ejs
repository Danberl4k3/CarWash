<%- include('../partials/head', { title, bodyClass: 'admin-page' }) %>
<%- include('../partials/admin-nav', { admin, csrfToken, activeNav: 'operacion' }) %>
<main class="admin-main">
  <div class="page-heading">
    <div>
      <span class="eyebrow">Control de operaciones</span>
      <h1>Panel de recojos</h1>
      <p>Vehículos organizados por la hora estimada de entrega.</p>
    </div>
    <div style="display: flex; gap: 8px; align-items: center;">
      <a class="primary-button" href="/"><%- include('../partials/icon', { name: 'plus' }) %> Nueva reserva</a>
    </div>
  </div>
  <%- include('../partials/alerts', { error, success }) %>

  <!-- Barra de navegación por fechas, alertas y exportación -->
  <section class="dashboard-controls-bar">
    <div class="date-navigator">
      <a href="/admin?date=<%= prevDate %>" class="btn-date-nav" title="Día anterior: <%= prevDate %>"><%- include('../partials/icon', { name: 'chevron-left' }) %></a>
      <div class="date-picker-wrap">
        <input type="date" id="admin-date-input" value="<%= selectedDate %>" class="date-picker-input" title="Seleccionar fecha">
        <% if (isToday) { %>
          <span class="badge-today">Hoy</span>
        <% } else { %>
          <a href="/admin" class="btn-today-link" title="Volver a la fecha de hoy">Ir a Hoy</a>
        <% } %>
      </div>
      <a href="/admin?date=<%= nextDate %>" class="btn-date-nav" title="Día siguiente: <%= nextDate %>"><%- include('../partials/icon', { name: 'chevron-right' }) %></a>
    </div>

    <div class="dashboard-extra-actions">
      <button type="button" id="toggle-sound-btn" class="action-pill sound-btn" title="Activar o silenciar avisos sonoros de reservas">
        <span class="sound-icon"><%- include('../partials/icon', { name: 'bell' }) %></span> <span class="sound-label">Avisos activos</span>
      </button>
      <a href="/admin/export-csv?date=<%= selectedDate %>" class="action-pill export-csv-btn" title="Descargar planilla de reservas en CSV / Excel">
        <%- include('../partials/icon', { name: 'download' }) %> Exportar CSV
      </a>
    </div>
  </section>

  <section class="financial-overview" aria-label="Resumen de cobros">
    <div class="financial-overview-heading">
      <div>
        <span class="eyebrow">Resumen de cobros</span>
        <h2>Ingresos del día seleccionado</h2>
      </div>
      <p>Reservas no canceladas · incluye abonos parciales</p>
    </div>
    <div class="financial-overview-grid">
      <article role="button" tabindex="0" class="financial-overview-card summary-clickable" data-summary-filter="pending_payment" title="Ver reservas con saldo por cobrar">
        <small>Falta cobrar</small>
        <strong><%= formatMoney(paymentBreakdown.totalPendingCents) %></strong>
        <span>Saldo pendiente</span>
      </article>
      <article class="financial-overview-card">
        <small>Se cobró</small>
        <strong><%= formatMoney(paymentBreakdown.totalCollectedCents) %></strong>
        <span>Pagos y abonos recibidos</span>
      </article>
      <article class="financial-overview-card financial-overview-total">
        <small>Total facturado</small>
        <strong><%= formatMoney(paymentBreakdown.totalExpectedCents) %></strong>
        <span>Cobrado + falta cobrar</span>
      </article>
    </div>
  </section>

  <section class="index-yape-bar admin-yape-quick-bar" aria-label="Cobrar con Yape">
    <span class="index-yape-prompt"><img class="brand-payment-icon" src="/public/img/payment-yape.png" alt=""> <strong>Cobrar con Yape:</strong></span>
    <div class="index-yape-buttons">
      <button type="button" class="btn-yape-pill" data-open-qr="hugo" title="Abrir código QR de Yape de Hugo"><img class="brand-payment-icon" src="/public/img/payment-yape.png" alt=""> <b>Hugo</b></button>
      <button type="button" class="btn-yape-pill" data-open-qr="roxana" title="Abrir código QR de Yape de Roxana"><img class="brand-payment-icon" src="/public/img/payment-yape.png" alt=""> <b>Roxana</b></button>
    </div>
  </section>

  <section class="summary-grid">
    <article role="button" tabindex="0" class="summary-clickable kpi-prominent" data-summary-filter="pending" title="Filtrar vehículos pendientes"><span class="summary-dot dot-amber"></span><small>En espera</small><strong><%= summary.pending %></strong></article>
    <article role="button" tabindex="0" class="summary-clickable kpi-prominent" data-summary-filter="in_progress" title="Filtrar vehículos en proceso"><span class="summary-dot dot-purple"></span><small>En proceso</small><strong><%= summary.inProgress %></strong></article>
    <article role="button" tabindex="0" class="summary-clickable kpi-prominent" data-summary-filter="completed" title="Filtrar vehículos listos"><span class="summary-dot dot-green"></span><small>Listos</small><strong><%= summary.completed %></strong></article>
    <div class="operation-meta">
      <button type="button" data-summary-filter="all"><b><%= summary.total %></b> vehículos hoy</button>
    </div>
  </section>

  <section class="next-up-card-container">
    <% if (nextBookingToEnter) { %>
      <div class="next-up-card">
        <div class="next-up-header">
          <span class="next-up-badge"><%- include('../partials/icon', { name: 'car-front' }) %> Siguiente por ingresar a pista</span>
          <span class="next-up-count"><%= pendingBookings.length %> en espera</span>
        </div>
        <div class="next-up-body">
          <div class="next-up-info">
            <div class="next-up-plate-line">
              <strong class="next-up-plate"><%= nextBookingToEnter.plate %></strong>
              <span class="vehicle-badge"><%= vehicleLabels[nextBookingToEnter.vehicle_type] %></span>
              <% if (nextBookingToEnter.vehicle_model) { %>
                <b class="next-up-model">· <%= nextBookingToEnter.vehicle_model %></b>
              <% } %>
            </div>
            <div class="next-up-meta">
              <span>Cliente: <b><%= nextBookingToEnter.customer_name || 'Sin nombre' %></b></span>
              <span>Servicio: <b><%= nextBookingToEnter.services %></b> <strong class="next-up-price-tag"><%= formatMoney(nextBookingToEnter.total_cents) %></strong></span>
              <span>Ingreso: <b><%= hourLabel(nextBookingToEnter.dropoff_hour, nextBookingToEnter.dropoff_minute === null ? 0 : nextBookingToEnter.dropoff_minute % 60) %></b></span>
            </div>
          </div>
          <div class="next-up-action">
            <form method="post" action="/admin/reservas/<%= nextBookingToEnter.id %>/quick-action">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" name="action" value="start_washing" class="start-wash-btn">
                <span><%- include('../partials/icon', { name: 'play' }) %> Iniciar lavado</span>
                <small>(<%= nextBookingToEnter.vehicle_type === 'small_suv' || nextBookingToEnter.vehicle_type === 'large_suv' ? '45 min' : '30 min' %>)</small>
              </button>
            </form>
          </div>
        </div>
        <% if (pendingBookings.length > 1) { %>
          <div class="next-up-queue">
            <small>Siguientes en cola:</small>
            <div class="queue-chips">
              <% pendingBookings.slice(1).forEach((b) => { %>
                <a href="#booking-<%= b.id %>" class="queue-chip">
                  <%= b.plate %> · <%= b.vehicle_model || vehicleLabels[b.vehicle_type] %>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="next-up-card empty-queue">
        <span><%- include('../partials/icon', { name: 'circle-check' }) %> <b>Todos los vehículos registrados han ingresado a lavado</b> · No hay turnos pendientes</span>
      </div>
    <% } %>
  </section>

  <div class="board-heading">
    <div class="board-heading-row">
      <h2>Panel de recojos por hora</h2>
      <div class="board-heading-actions">
        <span class="board-date"><%= selectedDate %></span>
      </div>
    </div>
    <div class="board-filters-container">
        <div class="board-search-wrap"><%- include('../partials/icon', { name: 'search' }) %><input type="search" id="board-search" class="board-search" data-plate-balance-input placeholder="Buscar placa o cliente..."><div class="plate-balance-popover" data-plate-balance-result role="status" aria-live="polite" hidden></div></div>
      <div class="status-filter-pills" id="board-status-filters">
        <button type="button" class="filter-pill active" data-filter="all">Todos</button>
        <button type="button" class="filter-pill pill-progress" data-filter="in_progress"><%- include('../partials/icon', { name: 'hourglass' }) %> En proceso</button>
        <button type="button" class="filter-pill pill-completed" data-filter="completed"><%- include('../partials/icon', { name: 'circle-check' }) %> Listos</button>
        <button type="button" class="filter-pill pill-paid" data-filter="paid"><%- include('../partials/icon', { name: 'banknote' }) %> Pagados</button>
        <button type="button" class="filter-pill pill-pending-pay" data-filter="pending_payment"><%- include('../partials/icon', { name: 'circle-alert' }) %> Por cobrar</button>
      </div>
      <div class="board-filter-toggle-row">
        <label class="hide-completed-paid-toggle" title="Ocultar del tablero los vehículos que ya están terminados y cobrados para dejar solo los autos activos">
          <input type="checkbox" id="toggle-hide-done-paid" checked>
          <span class="toggle-slider"></span>
          <span class="toggle-text">Ocultar listos y pagados</span>
        </label>
        <span class="filtered-counter" id="filtered-counter"></span>
      </div>
    </div>
  </div>

  <section class="pickup-board" data-live-board>
    <div class="hourly-summary">
      <h3 class="hourly-summary-title">Vehículos por hora</h3>
      <% if (hourlySummary.length === 0) { %>
        <p class="hourly-summary-empty">Sin vehículos programados</p>
      <% } else { %>
        <ul class="hourly-summary-chips">
          <% hourlySummary.forEach(item => { %>
            <li class="hourly-chip"><%= item.label %> (<%= item.count %>)</li>
          <% }); %>
        </ul>
      <% } %>
    </div>
    <% pickupGroups.forEach(group => { %>
      <article class="pickup-column <%= group.hour === 17 ? 'featured-hour' : '' %>">
        <header><div><small>Listos para</small><h3><%= group.label %></h3></div><span><%= group.activeCount %></span></header>
        <div class="pickup-stack">
          <% group.bookings.forEach(booking => { %>
            <div class="vehicle-card status-<%= booking.status %>" id="booking-<%= booking.id %>"
                 data-started-at="<%= booking.started_washing_at || '' %>"
                 data-vehicle-type="<%= booking.vehicle_type %>"
                 data-status="<%= booking.status %>"
                 data-payment-status="<%= booking.payment_status %>">
              <div class="vehicle-card-top">
                <div class="badges-row">
                  <span class="status-badge badge-<%= booking.status %>"><%= statusLabels[booking.status] %></span>
                  <span class="payment-badge badge-<%= booking.payment_status %>"><%= booking.payment_status === 'paid' ? 'Pagado' : 'Por cobrar' %></span>
                  <span class="vehicle-badge"><%= vehicleLabels[booking.vehicle_type] %></span>
                </div>
                <details class="card-more-menu">
                  <summary class="card-more-trigger" title="Más opciones" aria-label="Más opciones de <%= booking.plate %>"><%- include('../partials/icon', { name: 'ellipsis-vertical' }) %></summary>
                  <div class="card-more-dropdown">
                    <a href="/admin/reservas/<%= booking.id %>" class="card-dropdown-link"><%- include('../partials/icon', { name: 'pencil' }) %> Ver / Editar detalle</a>
                    <form method="post" action="/admin/reservas/<%= booking.id %>/eliminar" class="card-delete-form" onsubmit="return confirm('¿Estás seguro de que deseas eliminar permanentemente el registro de <%= booking.plate %>? Esta acción no se puede deshacer.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="redirectDate" value="<%= selectedDate %>">
                      <button type="submit" class="card-delete-btn" title="Eliminar registro" aria-label="Eliminar registro"><%- include('../partials/icon', { name: 'trash' }) %> Eliminar</button>
                    </form>
                  </div>
                </details>
              </div>

              <div class="plate-row">
                <a href="/admin/reservas/<%= booking.id %>" class="plate-number" title="Ver detalle de <%= booking.plate %>"><%= booking.plate %></a>
                <% if (booking.vehicle_model) { %>
                  <span class="card-model">· <%= booking.vehicle_model %></span>
                <% } %>
              </div>

              <div class="card-timing-row">
                <div class="card-pickup-highlight">
                  <span class="time-label">Recojo:</span>
                  <strong class="pickup-highlight-time"><%- include('../partials/icon', { name: 'clock-3' }) %> <%= hourLabel(booking.pickup_hour, booking.pickup_minute === null ? 0 : booking.pickup_minute % 60) %></strong>
                </div>
                <div class="card-dropoff-sub">
                  <span>Ingreso: <b><%= hourLabel(booking.dropoff_hour, booking.dropoff_minute === null ? 0 : booking.dropoff_minute % 60) %></b></span>
                </div>
              </div>

              <p class="card-customer">
                <% if (booking.customer_id) { %>
                  <a href="/admin/clientes/<%= booking.customer_id %>" class="customer-link"><%= booking.customer_name %></a>
                <% } else { %>
                  <span><%= booking.customer_name || 'Cliente sin nombre' %></span>
                <% } %>
              </p>

              <div class="card-service-section highlight-on-update">
                <span class="card-service-name"><%- include('../partials/icon', { name: 'sparkles' }) %> <%= booking.services || 'Sin servicio asignado' %></span>
                <span class="card-service-price"><%= formatMoney(booking.total_cents) %></span>
              </div>
              <% if (booking.payment_status !== 'paid') { %>
                <div class="card-balance"><span>Saldo pendiente</span><strong><%= formatMoney(Math.max(0, booking.total_cents - booking.amount_paid_cents)) %></strong></div>
              <% } %>

              <% if (booking.status === 'in_progress' && booking.started_washing_at) { %>
                <div class="wash-timer-card" data-wash-timer>
                  <div class="wash-timer-row">
                    <span class="wash-timer-label"><%- include('../partials/icon', { name: 'hourglass' }) %> <span class="wash-timer-text">Lavando...</span></span>
                    <strong class="wash-timer-remain">-- min</strong>
                  </div>
                  <div class="wash-progress-track"><div class="wash-progress-bar"></div></div>
                </div>
              <% } %>

              <div class="quick-actions">
                <form method="post" action="/admin/reservas/<%= booking.id %>/quick-action">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="action-row">
                    <div class="action-main-btn-wrap">
                      <% if (booking.status === 'pending') { %>
                        <button type="submit" name="action" value="next_status" class="action-btn-status action-btn-start" title="Avanzar a En proceso"><%- include('../partials/icon', { name: 'play' }) %> Iniciar lavado</button>
                      <% } else if (booking.status === 'in_progress') { %>
                        <button type="submit" name="action" value="next_status" class="action-btn-status action-btn-finish" title="Avanzar a Terminado"><%- include('../partials/icon', { name: 'check' }) %> Marcar listo</button>
                      <% } else if (booking.status === 'completed') { %>
                        <button type="submit" name="action" value="next_status" class="action-btn-status action-btn-delivered" disabled title="Vehículo terminado"><%- include('../partials/icon', { name: 'check' }) %> Listo</button>
                      <% } else { %>
                        <button type="submit" name="action" value="next_status" class="action-btn-status action-btn-cancelled" disabled>Cancelada</button>
                      <% } %>
                    </div>
                    <div class="action-secondary-group">
                      <button type="submit" name="action" value="prev_status" class="btn-prev-status" title="Retroceder estado" <%= booking.status === 'pending' || booking.status === 'cancelled' ? 'disabled' : '' %>><%- include('../partials/icon', { name: 'undo-2' }) %></button>
                      <button type="submit" name="action" value="toggle_payment" class="toggle-btn <%= booking.payment_status === 'paid' ? 'is-paid' : '' %>">
                        <%= booking.payment_status === 'paid' ? 'Pagado' : 'Cobrar' %>
                      </button>
                      <a href="/admin/reservas/<%= booking.id %>/ticket" target="_blank" title="Imprimir ticket" class="ticket-btn"><%- include('../partials/icon', { name: 'printer' }) %></a>
                      <% if (booking.phone) { %>
                        <a href="https://wa.me/<%= booking.phone.replace(/\D/g, '') %>?text=<%= encodeURIComponent(`Hola ${(booking.customer_name || 'Amigo').split(' ')[0]}, tu vehículo de placa ${booking.plate} ya está listo y reluciente en DASAV Car Wash. Monto: S/ ${(booking.total_cents / 100).toFixed(2)}. ¡Te esperamos!`) %>" target="_blank" class="wa-btn" title="Avisar por WhatsApp: ¡Vehículo listo!"><%- include('../partials/icon', { name: 'message-circle' }) %></a>
                      <% } %>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </article>
    <% }) %>
  </section>

  <!-- Módulo secundario: Cierre de caja -->
  <details class="cash-breakdown-panel cash-disclosure" id="cash-disclosure">
    <summary class="cash-disclosure-summary">
      <div class="cash-disclosure-header">
        <span class="cash-title-text"><%- include('../partials/icon', { name: 'banknote' }) %> <strong>Cierre de caja · <%= selectedDate %></strong></span>
        <% if (paymentBreakdown.totalPendingCents > 0) { %>
          <span class="pending-to-collect">Por cobrar: <b><%= formatMoney(paymentBreakdown.totalPendingCents) %></b></span>
        <% } else { %>
          <span class="all-collected"><%- include('../partials/icon', { name: 'check' }) %> 100% cobrado</span>
        <% } %>
        <span class="cash-disclosure-arrow" aria-hidden="true">▾</span>
      </div>
    </summary>
    <div class="cash-disclosure-content">
      <div class="cash-breakdown-chips">
        <div class="cash-chip chip-yape">
          <span class="chip-label"><img class="brand-payment-icon" src="/public/img/payment-yape.png" alt=""> Yape</span>
          <strong><%= formatMoney(paymentBreakdown.yapeCents) %></strong>
        </div>
        <div class="cash-chip chip-plin">
          <span class="chip-label"><img class="brand-payment-icon" src="/public/img/payment-plin.png" alt=""> Plin</span>
          <strong><%= formatMoney(paymentBreakdown.plinCents) %></strong>
        </div>
        <div class="cash-chip chip-cash">
          <span class="chip-label"><img class="brand-payment-icon" src="/public/img/payment-cash.svg" alt=""> Efectivo</span>
          <strong><%= formatMoney(paymentBreakdown.cashCents) %></strong>
        </div>
      </div>
    </div>
  </details>
</main>
<script src="/public/admin.js?v=13" defer></script>
<script src="/public/plate-balances.js?v=1" defer></script>
<%- include('../partials/footer') %>

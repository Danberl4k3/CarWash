<%- include('../partials/head', { title, bodyClass: 'admin-page dashboard-page' }) %>
<%- include('../partials/admin-nav', { admin, csrfToken, activeNav: 'operacion' }) %>
<aside class="dashboard-sidebar" aria-label="Menú de administración">
  <a class="sidebar-brand" href="/admin"><strong>DASAV</strong><small>CAR WASH</small></a>
  <nav class="sidebar-nav">
    <a href="#dashboard-summary"><span>⌂</span> Resumen</a>
    <a href="#agenda" class="active"><span>▣</span> Agenda</a>
    <a href="/admin/clientes"><span>♧</span> Clientes</a>
    <a href="/admin/servicios"><span>✦</span> Servicios</a>
    <a href="/admin/estadisticas"><span>▥</span> Reportes</a>
    <a href="/admin/capacidad"><span>◷</span> Capacidad</a>
  </nav>
  <div class="sidebar-bottom">
    <div class="sidebar-theme"><span>☾ Modo oscuro</span><button class="theme-toggle-btn" type="button" aria-label="Cambiar tema" title="Modo claro">🌙</button></div>
    <span class="sidebar-user"><%= admin.username %></span>
    <form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Salir</button></form>
  </div>
</aside>
<main class="admin-main">
  <div class="dashboard-top">
  <div class="page-heading">
    <div>
      <h1>Agenda de lavados</h1>
      <p><%= new Date(`${selectedDate}T12:00:00`).toLocaleDateString('es-PE', { weekday: 'long', day: 'numeric', month: 'long' }) %></p>
    </div>
  </div>

  <!-- Barra de navegación por fechas, alertas y exportación -->
  <section class="dashboard-controls-bar">
    <div class="date-navigator">
      <a href="/admin?date=<%= prevDate %>" class="btn-date-nav" title="Día anterior: <%= prevDate %>">◀</a>
      <div class="date-picker-wrap">
        <input type="date" id="admin-date-input" value="<%= selectedDate %>" class="date-picker-input" title="Seleccionar fecha">
        <% if (isToday) { %>
          <span class="badge-today">Hoy</span>
        <% } else { %>
          <a href="/admin" class="btn-today-link" title="Volver a la fecha de hoy">Ir a Hoy</a>
        <% } %>
      </div>
      <a href="/admin?date=<%= nextDate %>" class="btn-date-nav" title="Día siguiente: <%= nextDate %>">▶</a>
    </div>

    <div class="dashboard-extra-actions">
      <a class="primary-button" href="/">＋ Nueva reserva</a>
      <button type="button" id="toggle-sound-btn" class="action-pill sound-btn" title="Activar o silenciar avisos sonoros de reservas">
        <span class="sound-icon">🔔</span> <span class="sound-label">Avisos activos</span>
      </button>
      <a href="/admin/export-csv?date=<%= selectedDate %>" class="action-pill export-csv-btn" title="Descargar planilla de reservas en CSV / Excel">
        📥 Exportar CSV
      </a>
    </div>
  </section>
  </div>
  <%- include('../partials/alerts', { error, success }) %>

  <section class="summary-grid" id="dashboard-summary">
    <article role="button" tabindex="0" class="summary-clickable kpi-prominent" data-summary-filter="all" title="Ver todos los vehículos"><span class="summary-dot dot-amber"></span><small>Reservas hoy</small><strong><%= summary.total %></strong></article>
    <article role="button" tabindex="0" class="summary-clickable kpi-prominent" data-summary-filter="in_progress" title="Filtrar vehículos en proceso"><span class="summary-dot dot-purple"></span><small>En proceso</small><strong><%= summary.inProgress %></strong></article>
    <article role="button" tabindex="0" class="summary-clickable kpi-prominent" data-summary-filter="pending" title="Filtrar vehículos pendientes"><span class="summary-dot dot-danger"></span><small>Pendientes</small><strong><%= summary.pending %></strong></article>
    <article role="button" tabindex="0" class="summary-clickable kpi-prominent" data-summary-filter="completed" title="Filtrar vehículos listos"><span class="summary-dot dot-green"></span><small>Terminadas</small><strong><%= summary.completed %></strong></article>
    <div class="operation-meta">
      <button type="button" data-summary-filter="all"><b><%= summary.total %></b> vehículos hoy</button>
      <button type="button" data-summary-filter="paid">Cobrado <b><%= formatMoney(summary.collected) %></b></button>
      <span>Proyectado <b><%= formatMoney(summary.expected) %></b></span>
    </div>
  </section>

  <section class="next-up-card-container">
    <% if (nextBookingToEnter) { %>
      <div class="next-up-card">
        <div class="next-up-header">
          <span class="next-up-badge">Siguiente carro</span>
          <span class="next-up-count"><%= pendingBookings.length %> en espera</span>
        </div>
        <div class="next-up-body">
          <div class="next-up-info">
            <div class="next-up-plate-line">
              <strong class="next-up-plate"><%= nextBookingToEnter.plate %></strong>
              <span class="vehicle-badge"><%= vehicleLabels[nextBookingToEnter.vehicle_type] %></span>
              <% if (nextBookingToEnter.vehicle_model) { %>
                <b class="next-up-model">· <%= nextBookingToEnter.vehicle_model %></b>
              <% } %>
            </div>
            <div class="next-up-meta">
              <span>Cliente: <b><%= nextBookingToEnter.customer_name || 'Sin nombre' %></b></span>
              <span>Servicio: <b><%= nextBookingToEnter.services %></b> <strong class="next-up-price-tag"><%= formatMoney(nextBookingToEnter.total_cents) %></strong></span>
              <span>Ingreso: <b><%= hourLabel(nextBookingToEnter.dropoff_hour, nextBookingToEnter.dropoff_minute === null ? 0 : nextBookingToEnter.dropoff_minute % 60) %></b></span>
            </div>
          </div>
          <div class="next-up-action">
            <form method="post" action="/admin/reservas/<%= nextBookingToEnter.id %>/quick-action">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" name="action" value="start_washing" class="start-wash-btn">
                <span>▶ Iniciar lavado</span>
                <small>(<%= nextBookingToEnter.vehicle_type === 'small_suv' || nextBookingToEnter.vehicle_type === 'large_suv' ? '45 min' : '30 min' %>)</small>
              </button>
            </form>
            <form method="post" action="/admin/reservas/<%= nextBookingToEnter.id %>/quick-action">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" name="action" value="toggle_payment" class="next-up-pay-btn"><%= nextBookingToEnter.payment_status === 'paid' ? '✓ Pagado' : '$ Cobrar' %></button>
            </form>
          </div>
        </div>
        <% if (pendingBookings.length > 1) { %>
          <div class="next-up-queue">
            <small>Después siguen</small>
            <div class="queue-chips">
              <% pendingBookings.slice(1, 4).forEach((b) => { %>
                <a href="#booking-<%= b.id %>" class="queue-chip">
                  <strong><%= b.plate %></strong><span><%= b.vehicle_model || vehicleLabels[b.vehicle_type] %> · <%= hourLabel(b.dropoff_hour, b.dropoff_minute === null ? 0 : b.dropoff_minute % 60) %></span><small><%= b.services %></small>
                </a>
              <% }) %>
            </div>
            <a class="view-queue-link" href="#agenda">Ver cola completa →</a>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="next-up-card empty-queue">
        <span>✨ <b>Todos los vehículos registrados han ingresado a lavado</b> · No hay turnos pendientes</span>
      </div>
    <% } %>
  </section>

  <div class="board-heading" id="agenda">
    <div class="board-heading-row">
      <h2>Busca un vehículo</h2>
      <div class="board-heading-actions">
        <span class="board-date"><%= selectedDate %></span>
      </div>
    </div>
    <div class="board-filters-container">
      <div class="board-search-row">
      <input type="search" id="board-search" class="board-search" placeholder="Buscar placa, cliente o servicio..." aria-label="Buscar placa, cliente o servicio" autocomplete="off">
      <div id="plate-search-result" class="plate-search-result" aria-live="polite" hidden></div>
      </div>
      <div class="status-filter-pills" id="board-status-filters">
        <button type="button" class="filter-pill active" data-filter="all">Todos</button>
        <button type="button" class="filter-pill pill-progress" data-filter="in_progress">⏳ En proceso</button>
        <button type="button" class="filter-pill pill-completed" data-filter="completed">✅ Listos</button>
        <button type="button" class="filter-pill pill-paid" data-filter="paid">💵 Pagados</button>
        <button type="button" class="filter-pill pill-pending-pay" data-filter="pending_payment">🔴 Por cobrar</button>
      </div>
      <div class="board-filter-toggle-row">
        <label class="hide-completed-paid-toggle" title="Ocultar del tablero los vehículos que ya están terminados y cobrados para dejar solo los autos activos">
          <input type="checkbox" id="toggle-hide-done-paid" checked>
          <span class="toggle-slider"></span>
          <span class="toggle-text">Ocultar listos y pagados</span>
        </label>
        <span class="filtered-counter" id="filtered-counter"></span>
      </div>
    </div>
  </div>

  <section class="pickup-board" data-live-board>
    <div class="hourly-summary">
      <div class="agenda-intro">
        <span class="agenda-kicker">AGENDA DEL DÍA</span>
        <h3 class="hourly-summary-title">Vehículos por hora</h3>
      </div>
      <% if (hourlySummary.length === 0) { %>
        <p class="hourly-summary-empty">Sin vehículos programados</p>
      <% } else { %>
        <ul class="hourly-summary-chips">
          <% hourlySummary.forEach(item => { %>
            <li class="hourly-chip"><a href="#hora-<%= item.hour %>" aria-label="<%= item.label %> (<%= item.count %>)"><strong><%= item.label %></strong><span><%= item.count %> <%= item.count === 1 ? 'vehículo' : 'vehículos' %></span></a></li>
          <% }); %>
        </ul>
      <% } %>
    </div>
    <% pickupGroups.forEach(group => { %>
      <article class="pickup-column <%= group.hour === 17 ? 'featured-hour' : '' %>" id="hora-<%= group.hour %>">
        <header><div><h3><%= group.label %> <small class="hour-count">· <%= group.bookings.length %> carros</small></h3></div><span><%= group.bookings.length %></span></header>
        <div class="pickup-stack">
          <% group.bookings.forEach((booking, index) => { %>
            <div class="vehicle-card status-<%= booking.status %>" id="booking-<%= booking.id %>"
                 data-started-at="<%= booking.started_washing_at || '' %>"
                 data-vehicle-type="<%= booking.vehicle_type %>"
                 data-status="<%= booking.status %>"
                 data-payment-status="<%= booking.payment_status %>">
              <div class="vehicle-card-top">
                <div class="badges-row">
                  <span class="status-badge badge-<%= booking.status %>"><%= statusLabels[booking.status] %></span>
                  <span class="payment-badge badge-<%= booking.payment_status %>"><%= booking.payment_status === 'paid' ? 'Pagado' : 'Por cobrar' %></span>
                  <span class="vehicle-badge"><%= vehicleLabels[booking.vehicle_type] %></span>
                </div>
                <details class="card-more-menu">
                  <summary class="card-more-trigger" title="Más opciones" aria-label="Más opciones de <%= booking.plate %>">⋮</summary>
                  <div class="card-more-dropdown">
                    <a href="/admin/reservas/<%= booking.id %>" class="card-dropdown-link">✏️ Ver / Editar detalle</a>
                    <form method="post" action="/admin/reservas/<%= booking.id %>/eliminar" class="card-delete-form" onsubmit="return confirm('¿Estás seguro de que deseas eliminar permanentemente el registro de <%= booking.plate %>? Esta acción no se puede deshacer.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="redirectDate" value="<%= selectedDate %>">
                      <button type="submit" class="card-delete-btn" title="Eliminar registro" aria-label="Eliminar registro">🗑️ Eliminar</button>
                    </form>
                  </div>
                </details>
              </div>

              <div class="plate-row">
                <span class="card-position"><%= index + 1 %></span>
                <a href="/admin/reservas/<%= booking.id %>" class="plate-number" title="Ver detalle de <%= booking.plate %>"><%= booking.plate %></a>
                <% if (booking.vehicle_model) { %>
                  <span class="card-model">· <%= booking.vehicle_model %></span>
                <% } %>
              </div>

              <div class="card-timing-row">
                <div class="card-pickup-highlight">
                  <span class="time-label">Recojo:</span>
                  <strong class="pickup-highlight-time"><%= hourLabel(booking.pickup_hour, booking.pickup_minute === null ? 0 : booking.pickup_minute % 60) %></strong>
                </div>
                <div class="card-dropoff-sub">
                  <span>Ingreso</span><b><%= hourLabel(booking.dropoff_hour, booking.dropoff_minute === null ? 0 : booking.dropoff_minute % 60) %></b>
                </div>
              </div>

              <p class="card-customer">
                <% if (booking.customer_id) { %>
                  <a href="/admin/clientes/<%= booking.customer_id %>" class="customer-link"><%= booking.customer_name %></a>
                <% } else { %>
                  <span><%= booking.customer_name || 'Cliente sin nombre' %></span>
                <% } %>
              </p>

              <div class="card-service-section highlight-on-update">
                <span class="card-service-name"><%= booking.services || 'Sin servicio asignado' %></span>
                <span class="card-service-price"><%= formatMoney(booking.total_cents) %></span>
              </div>
              <% if (booking.payment_status !== 'paid') { %>
                <div class="card-balance"><span>Saldo pendiente</span><strong><%= formatMoney(Math.max(0, booking.total_cents - booking.amount_paid_cents)) %></strong></div>
              <% } %>

              <% if (booking.status === 'in_progress' && booking.started_washing_at) { %>
                <div class="wash-timer-card" data-wash-timer>
                  <div class="wash-timer-row">
                    <span class="wash-timer-label">⏳ Lavando...</span>
                    <strong class="wash-timer-remain">-- min</strong>
                  </div>
                  <div class="wash-progress-track"><div class="wash-progress-bar"></div></div>
                </div>
              <% } %>

              <div class="quick-actions">
                <form method="post" action="/admin/reservas/<%= booking.id %>/quick-action">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="action-row">
                    <div class="action-main-btn-wrap">
                      <% if (booking.status === 'pending') { %>
                        <button type="submit" name="action" value="next_status" class="action-btn-status action-btn-start" title="Avanzar a En proceso">▶ Iniciar lavado</button>
                      <% } else if (booking.status === 'in_progress') { %>
                        <button type="submit" name="action" value="next_status" class="action-btn-status action-btn-finish" title="Avanzar a Terminado">✓ Marcar listo</button>
                      <% } else if (booking.status === 'completed') { %>
                        <button type="submit" name="action" value="next_status" class="action-btn-status action-btn-delivered" disabled title="Vehículo terminado">✓ Listo</button>
                      <% } else { %>
                        <button type="submit" name="action" value="next_status" class="action-btn-status action-btn-cancelled" disabled>Cancelada</button>
                      <% } %>
                    </div>
                    <div class="action-secondary-group">
                      <button type="submit" name="action" value="prev_status" class="btn-prev-status" title="Retroceder estado" <%= booking.status === 'pending' || booking.status === 'cancelled' ? 'disabled' : '' %>>↩</button>
                      <button type="submit" name="action" value="toggle_payment" class="toggle-btn <%= booking.payment_status === 'paid' ? 'is-paid' : '' %>">
                        <%= booking.payment_status === 'paid' ? 'Pagado' : 'Cobrar' %>
                      </button>
                      <a href="/admin/reservas/<%= booking.id %>/ticket" target="_blank" title="Imprimir ticket" class="ticket-btn">🖨️</a>
                      <% if (booking.phone) { %>
                        <a href="https://wa.me/<%= booking.phone.replace(/\D/g, '') %>?text=<%= encodeURIComponent(`Hola ${(booking.customer_name || 'Amigo').split(' ')[0]}, tu vehículo de placa ${booking.plate} ya está listo y reluciente en DASAV Car Wash. Monto: S/ ${(booking.total_cents / 100).toFixed(2)}. ¡Te esperamos!`) %>" target="_blank" class="wa-btn" title="Avisar por WhatsApp: ¡Vehículo listo!">💬</a>
                      <% } %>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </article>
    <% }) %>
  </section>

  <!-- Módulo secundario: Cierre de caja y QRs de cobro rápido -->
  <details class="cash-breakdown-panel cash-disclosure" id="cash-disclosure">
    <summary class="cash-disclosure-summary">
      <div class="cash-disclosure-header">
        <span class="cash-title-text">💵 <strong>Cierre de caja y QRs de cobro · <%= selectedDate %></strong></span>
        <% if (paymentBreakdown.totalPendingCents > 0) { %>
          <span class="pending-to-collect">Por cobrar: <b><%= formatMoney(paymentBreakdown.totalPendingCents) %></b></span>
        <% } else { %>
          <span class="all-collected">✓ 100% cobrado</span>
        <% } %>
        <span class="cash-disclosure-arrow" aria-hidden="true">▾</span>
      </div>
    </summary>
    <div class="cash-disclosure-content">
      <div class="cash-breakdown-chips">
        <div class="cash-chip chip-yape">
          <span class="chip-label">🟣 Yape</span>
          <strong><%= formatMoney(paymentBreakdown.yapeCents) %></strong>
        </div>
        <div class="cash-chip chip-plin">
          <span class="chip-label">🔵 Plin</span>
          <strong><%= formatMoney(paymentBreakdown.plinCents) %></strong>
        </div>
        <div class="cash-chip chip-cash">
          <span class="chip-label">💵 Efectivo</span>
          <strong><%= formatMoney(paymentBreakdown.cashCents) %></strong>
        </div>
      </div>
      <div class="admin-qr-quick-bar">
        <span class="admin-qr-title">📱 QRs de Cobro rápido:</span>
        <div class="admin-qr-btns">
          <button type="button" class="admin-yape-btn" data-open-qr="hugo" onclick="openYapeQr('hugo')">🟣 Yape Hugo</button>
          <button type="button" class="admin-yape-btn" data-open-qr="roxana" onclick="openYapeQr('roxana')">🟣 Yape Roxana</button>
        </div>
      </div>
    </div>
  </details>
</main>
<script src="/public/admin.js?v=14" defer></script>
<%- include('../partials/footer') %>

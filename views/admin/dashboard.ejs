<%- include('../partials/head', { title, bodyClass: 'admin-page' }) %>
<%- include('../partials/admin-nav', { admin, csrfToken }) %>
<main class="admin-main">
  <div class="page-heading">
    <div><span class="eyebrow">Operación de hoy</span><h1>Panel de recojos</h1><p>Todos los vehículos organizados por la hora en que estarán listos.</p></div>
    <a class="primary-button" href="/">+ Nueva reserva</a>
  </div>
  <%- include('../partials/alerts', { error, success }) %>

  <section class="summary-grid">
    <article><span class="summary-dot dot-blue"></span><small>Vehículos hoy</small><strong><%= summary.total %></strong></article>
    <article><span class="summary-dot dot-amber"></span><small>Pendientes</small><strong><%= summary.pending %></strong></article>
    <article><span class="summary-dot dot-purple"></span><small>En proceso</small><strong><%= summary.inProgress %></strong></article>
    <article><span class="summary-dot dot-green"></span><small>Terminados</small><strong><%= summary.completed %></strong></article>
    <article><span class="summary-dot" style="background: #9fb4bb"></span><small>Total (Proyectado)</small><strong><%= formatMoney(summary.expected) %></strong></article>
    <article><span class="summary-dot dot-mint"></span><small>Cobrado</small><strong><%= formatMoney(summary.collected) %></strong></article>
  </section>

  <section class="next-up-card-container">
    <% if (nextBookingToEnter) { %>
      <div class="next-up-card">
        <div class="next-up-header">
          <span class="next-up-badge">🚗 Siguiente por ingresar</span>
          <span class="next-up-count"><%= pendingBookings.length %> <%= pendingBookings.length === 1 ? 'en espera' : 'en espera' %></span>
        </div>
        <div class="next-up-body">
          <div class="next-up-info">
            <div class="next-up-plate-line">
              <strong class="next-up-plate"><%= nextBookingToEnter.plate %></strong>
              <span class="vehicle-badge"><%= vehicleLabels[nextBookingToEnter.vehicle_type] %></span>
              <% if (nextBookingToEnter.vehicle_model) { %>
                <b class="next-up-model">· <%= nextBookingToEnter.vehicle_model %></b>
              <% } %>
            </div>
            <div class="next-up-meta">
              <span>Cliente: <b><%= nextBookingToEnter.customer_name || 'Sin nombre' %></b></span>
              <span>Servicio: <b><%= nextBookingToEnter.services %></b></span>
              <span>Ingreso: <b><%= hourLabel(nextBookingToEnter.dropoff_hour, nextBookingToEnter.dropoff_minute === null ? 0 : nextBookingToEnter.dropoff_minute % 60) %></b></span>
            </div>
          </div>
          <div class="next-up-action">
            <form method="post" action="/admin/reservas/<%= nextBookingToEnter.id %>/quick-action">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" name="action" value="start_washing" class="start-wash-btn">
                <span>▶ Iniciar lavado</span>
                <small>(<%= nextBookingToEnter.vehicle_type === 'small_suv' || nextBookingToEnter.vehicle_type === 'large_suv' ? '45 min' : '30 min' %>)</small>
              </button>
            </form>
          </div>
        </div>
        <% if (pendingBookings.length > 1) { %>
          <div class="next-up-queue">
            <small>Siguientes en cola:</small>
            <div class="queue-chips">
              <% pendingBookings.slice(1).forEach((b) => { %>
                <a href="#booking-<%= b.id %>" class="queue-chip">
                  <%= b.plate %> · <%= b.vehicle_model || vehicleLabels[b.vehicle_type] %>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="next-up-card empty-queue">
        <span>✨ <b>Todos los vehículos del día han ingresado a lavado</b> · No hay turnos pendientes</span>
      </div>
    <% } %>
  </section>

  <div class="board-heading">
    <div class="board-heading-row">
      <h2>Recojos por hora</h2>
      <div class="board-heading-actions">
        <span class="board-date"><%= now.date %></span>
      </div>
    </div>
    <input type="search" id="board-search" class="board-search" placeholder="🔍 Buscar placa o cliente...">
  </div>
  <section class="pickup-board" data-live-board>
    <div class="hourly-summary">
      <h3 class="hourly-summary-title">Vehículos por hora</h3>
      <% if (hourlySummary.length === 0) { %>
        <p class="hourly-summary-empty">Sin vehículos programados</p>
      <% } else { %>
        <ul class="hourly-summary-chips">
          <% hourlySummary.forEach(item => { %>
            <li class="hourly-chip"><%= item.label %> (<%= item.count %>)</li>
          <% }); %>
        </ul>
      <% } %>
    </div>
    <% pickupGroups.forEach(group => { %>
      <article class="pickup-column <%= group.hour === 17 ? 'featured-hour' : '' %>">
        <header><div><small>Listos para</small><h3><%= group.label %></h3></div><span><%= group.activeCount %></span></header>
        <div class="pickup-stack">
          <% group.bookings.forEach(booking => { %>
            <div class="vehicle-card status-<%= booking.status %>" id="booking-<%= booking.id %>"
                 data-started-at="<%= booking.started_washing_at || '' %>"
                 data-vehicle-type="<%= booking.vehicle_type %>">
              <div class="vehicle-card-top">
                <div>
                  <span class="vehicle-badge"><%= vehicleLabels[booking.vehicle_type] %></span>
                  <span class="status-badge badge-<%= booking.status %>"><%= statusLabels[booking.status] %></span>
                </div>
                <span class="payment-badge badge-<%= booking.payment_status %>"><%= booking.payment_status === 'paid' ? 'Pagado' : 'Por pagar' %></span>
              </div>
              <div class="plate-row">
                <a href="/admin/reservas/<%= booking.id %>" class="plate-number"><%= booking.plate %></a>
                <a href="/admin/reservas/<%= booking.id %>/ticket" target="_blank" title="Imprimir ticket" class="ticket-btn">🖨️</a>
              </div>
              <p>
                <% if (booking.customer_id) { %>
                  <a href="/admin/clientes/<%= booking.customer_id %>" class="customer-link" style="display:inline;"><%= booking.customer_name %></a>
                <% } else { %>
                  <span><%= booking.customer_name || 'Cliente sin nombre' %></span>
                <% } %>
                <% if (booking.vehicle_model) { %>
                  <b style="color: var(--aqua-dark); font-weight: 700;">· <%= booking.vehicle_model %></b>
                <% } %>
              </p>
              <small><%= booking.services %></small>
              <div class="vehicle-meta"><span>Ingreso <b><%= hourLabel(booking.dropoff_hour, booking.dropoff_minute === null ? 0 : booking.dropoff_minute % 60) %></b></span><span>Recojo <b><%= hourLabel(booking.pickup_hour, booking.pickup_minute === null ? 0 : booking.pickup_minute % 60) %></b></span></div>
              <% if (booking.status === 'in_progress' && booking.started_washing_at) { %>
                <div class="wash-timer-card" data-wash-timer>
                  <div class="wash-timer-row">
                    <span class="wash-timer-label">⏳ Lavando...</span>
                    <strong class="wash-timer-remain">-- min</strong>
                  </div>
                  <div class="wash-progress-track"><div class="wash-progress-bar"></div></div>
                </div>
              <% } %>
              <div class="quick-actions">
                <form method="post" action="/admin/reservas/<%= booking.id %>/quick-action">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="action-row">
                    <div class="status-stepper">
                      <button type="submit" name="action" value="prev_status" title="Retroceder estado" <%= booking.status === 'pending' || booking.status === 'cancelled' ? 'disabled' : '' %>>◀</button>
                      <button type="submit" name="action" value="next_status" title="Avanzar estado" <%= booking.status === 'completed' || booking.status === 'cancelled' ? 'disabled' : '' %>>▶</button>
                    </div>
                    <div class="payment-stepper" style="display: flex; gap: 4px;">
                      <button type="submit" name="action" value="toggle_payment" class="toggle-btn <%= booking.payment_status === 'paid' ? 'is-paid' : '' %>">
                        <%= booking.payment_status === 'paid' ? 'Pagado' : 'Cobrar' %>
                      </button>
                      <% if (booking.phone) { %>
                        <a href="https://wa.me/<%= booking.phone.replace(/\D/g, '') %>?text=Hola <%= encodeURIComponent((booking.customer_name || 'Amigo').split(' ')[0]) %>, tu veh%C3%ADculo de placa <%= booking.plate %> ya est%C3%A1 listo y reluciente en D'Asav Car Wash. %C2%A1Te esperamos!" target="_blank" class="wa-btn" title="Avisar por WhatsApp">💬</a>
                      <% } %>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </article>
    <% }) %>
</section>
</main>
<script src="/public/admin.js?v=7" defer></script>
<%- include('../partials/footer') %>

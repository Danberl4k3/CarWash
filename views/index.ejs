<%- include('partials/head', { title, bodyClass: 'public-page' }) %>
<header class="public-header">
  <a class="public-brand" href="/">
    <span><strong>DASAV</strong><small>CAR WASH</small></span>
  </a>
  <nav class="public-nav" aria-label="Navegación principal">
    <a class="active" href="#booking-form">Reservar</a>
    <a href="#booking-services">Servicios</a>
    <a href="#booking-summary">Tu reserva</a>
  </nav>
  <div class="public-header-actions">
    <button class="theme-toggle-btn" type="button" aria-label="Cambiar tema" title="Modo claro">🌙</button>
    <span class="theme-toggle-label">Modo oscuro</span>
    <a class="admin-link" href="/admin/login">Administración</a>
  </div>
</header>

<main class="booking-shell">
  <section class="booking-intro">
    <h1>Reserva tu lavado</h1>
    <p>Tu vehículo, siempre en las mejores manos. Completa los datos y confirma tu reserva en minutos.</p>
  </section>

  <section class="booking-panel">
    <%- include('partials/alerts', { error, success: null }) %>

<form id="booking-form" class="booking-form booking-sheet" method="post" action="/reservar"
      data-catalog="<%= serviceCatalog %>" data-now-hour="<%= now.hour %>">

      <fieldset class="booking-section booking-vehicle">
        <legend><span class="section-number">01</span><span>Datos del vehículo<small>Ingresa la información de tu vehículo.</small></span></legend>

        <div class="vehicle-fields">
        <div class="field-wrapper plate-wrapper">
          <label for="plate-input">Placa <b>*</b></label>
          <div class="plate-input-group">
            <input name="plate" id="plate-input" maxlength="12" placeholder="ABC-123" autocomplete="off" required>
            <label for="plate-camera-input" id="btn-scan-plate" class="plate-action-btn" title="Escanear placa con cámara o foto" role="button" tabindex="0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="action-svg" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              <span class="btn-text">Escanear</span>
            </label>
            <button type="button" id="btn-lookup-plate" class="plate-action-btn plate-lookup-btn" title="Consultar placa en SUNARP">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="action-svg" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <span class="btn-text">Consultar</span>
            </button>
          </div>
          <input type="file" id="plate-camera-input" accept="image/*" capture="environment" class="visually-hidden-file-input">
          <div id="plate-feedback" class="plate-feedback" style="display: none;"></div>
        </div>
        <label>Marca / Modelo<input name="model" list="car-brands" maxlength="100" placeholder="Ej. Toyota, Hyundai, Kia..." autocomplete="off"></label>
        </div>

        <div class="booking-subgroup">
          <h3 class="booking-group-title">¿Qué vehículo traes?</h3>
          <div class="choice-grid vehicle-grid">
            <% Object.entries(vehicleLabels).forEach(([value, label], index) => { %>
              <label class="choice-card">
                <input type="radio" name="vehicleType" value="<%= value %>" <%= index === 1 ? 'checked' : '' %> required>
                <span class="vehicle-icon vehicle-<%= value %>"></span>
                <strong><%= label %></strong>
              </label>
            <% }) %>
          </div>
        </div>

      </fieldset>

      <fieldset class="booking-section booking-services" id="booking-services">
        <legend><span class="section-number">02</span><span>Lavado principal<small>Selecciona el servicio principal para tu vehículo.</small></span></legend>
        <div class="booking-subgroup">
          <div class="service-list">
            <% services.filter(service => service.category === 'base').forEach((service, index) => { %>
              <label class="service-option">
                <input type="radio" name="baseServiceId" value="<%= service.id %>" data-slug="<%= service.slug %>" <%= index === 1 ? 'checked' : '' %> required>
                <span class="service-glyph" aria-hidden="true"><%= { 'motorcycle-wash': '♧', interior: '◧', exterior: '✦', complete: '▣' }[service.slug] || '✦' %></span>
                <span><strong><%= service.name %></strong></span>
                <b class="service-price" data-service-price="<%= service.id %>">—</b>
              </label>
            <% }) %>
          </div>
        </div>

      </fieldset>

      <fieldset class="booking-section addon-section booking-addons">
        <legend><span class="section-number">03</span><span>Adicionales<small>Selecciona los servicios adicionales que desees.</small></span></legend>
        <div class="booking-subgroup">
          <div class="addon-grid">
            <% services.filter(service => service.category === 'addon').forEach(service => { %>
              <label class="addon-option" data-addon-slug="<%= service.slug %>" data-incompatible-interior="<%= service.incompatible_with_interior %>">
                <input type="checkbox" name="addonServiceIds" value="<%= service.id %>">
                <span class="check-mark">✓</span>
                <span class="service-glyph" aria-hidden="true"><%= { engine: '⚙', leather: '♙', wax: '✧', 'seat-wash': '◧' }[service.slug] || '✦' %></span>
                <span><strong><%= service.name %></strong><small class="service-price" data-service-price="<%= service.id %>">—</small></span>
              </label>
            <% }) %>
          </div>
        </div>

      </fieldset>

      <fieldset class="booking-section booking-details">
        <legend><span class="section-number">04</span><span>Tus datos<small>Completa tus datos para la reserva (opcional).</small></span></legend>
        <div class="field-grid two-columns">
          <label><span>Nombre <small>Opcional</small></span><input name="name" maxlength="200" placeholder="¿A nombre de quién?"></label>
          <label id="phone-field"><span>Teléfono <small id="phone-optional">Opcional</small></span><input type="tel" name="phone" id="phone" maxlength="20" placeholder="999 999 999"></label>
        </div>
        <% if (csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>
        <details class="notes-disclosure"><summary>+ Indicaciones opcionales</summary><label><span>Indicaciones</span><textarea name="notes" rows="2" maxlength="1000" placeholder="Nivel de suciedad, objetos delicados u otra indicación"></textarea></label></details>

      </fieldset>

      <fieldset class="booking-section booking-schedule">
        <legend><span class="section-number">05</span><span>Horario y pago<small>Confirma el horario de tu reserva y el método de pago.</small></span></legend>
        <div class="schedule-layout">
        <div class="field-grid two-columns schedule-fields">
          <label>Hora de ingreso
            <input id="dropoff-display" value="<%= hourLabel(automaticDropoff.hour, automaticDropoff.minute) %>" readonly>
            <input type="hidden" name="dropoffHour" id="dropoff-hour" value="<%= automaticDropoff.hour %>">
            <input type="hidden" name="dropoffMinute" id="dropoff-minute" value="<%= automaticDropoff.minute %>">
          </label>
          <label>Hora estimada de recojo
            <input type="time" name="pickupTime" id="pickup-time">
            <div class="time-buttons">
              <button type="button" data-pickup-offset="30">+ 30 min</button>
              <button type="button" data-pickup-offset="60">+ 1 hora</button>
              <button type="button" data-pickup-offset="90">+ 1 h 30</button>
              <button type="button" data-pickup-offset="120">+ 2 horas</button>
            </div>
          </label>
        </div>
        <%- include('partials/payment-choices', { paymentLabels }) %>
        </div>
      </fieldset>

    </form>
  </section>
  <aside class="booking-summary" id="booking-summary" aria-label="Resumen de la reserva">
    <h2>Tu reserva</h2>
    <p class="summary-caption">Revisa los detalles antes de confirmar.</p>
    <div class="summary-vehicle"><span class="summary-vehicle-icon" aria-hidden="true">▣</span><div><span id="summary-model">Auto</span><small>Placa <strong id="summary-plate">Por ingresar</strong></small></div></div>
    <dl class="summary-lines">
      <div><dt><span class="summary-line-icon">▣</span><span id="summary-service">—</span></dt><dd id="summary-service-price">—</dd></div>
      <div><dt><span class="summary-line-icon">✧</span><span id="summary-addons">Ninguno</span></dt><dd id="summary-addons-price">—</dd></div>
      <div><dt><span class="summary-line-icon">◷</span>Hora de ingreso</dt><dd id="summary-dropoff"><%= hourLabel(automaticDropoff.hour, automaticDropoff.minute) %></dd></div>
      <div><dt><span class="summary-line-icon">◷</span>Hora estimada de recojo</dt><dd id="summary-pickup">Por elegir</dd></div>
    </dl>
      <div class="booking-total">
        <span><small>Total estimado</small><strong id="booking-total">S/ 0.00</strong></span>
        <button class="primary-button global-submit-btn" type="submit" form="booking-form">Confirmar reserva <span>→</span></button>
      </div>
      <p class="summary-secure">♙ Tu información se utilizará solo para gestionar tu reserva.</p>
      <div class="index-yape-bar">
        <span class="index-yape-prompt">🟣 <strong>Pagar con Yape</strong><small>Escanea uno de los códigos QR para pagar.</small></span>
        <div class="index-yape-buttons">
          <button type="button" class="btn-yape-pill" data-open-qr="hugo" onclick="openYapeQr('hugo')" title="Abrir código QR de Yape de Hugo">
            <span>▦</span> <b>Ver QR de Hugo</b>
          </button>
          <button type="button" class="btn-yape-pill" data-open-qr="roxana" onclick="openYapeQr('roxana')" title="Abrir código QR de Yape de Roxana">
            <span>▦</span> <b>Ver QR de Roxana</b>
          </button>
        </div>
      </div>
      <p class="price-note">Si un precio figura en cero, será confirmado en el local.</p>
  </aside>
</main>
<script src="/public/booking.js?v=16" defer></script>
<%- include('partials/footer') %>

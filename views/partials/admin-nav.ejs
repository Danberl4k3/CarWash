<header class="admin-topbar">
  <div class="admin-topbar-brand-row">
    <a class="admin-brand" href="/admin">
      <span class="brand-mark">DA</span>
      <span><strong>DASAV Car Wash</strong><small>Centro de control</small></span>
    </a>
    <div class="admin-user">
      <button class="theme-toggle-btn" type="button" aria-label="Cambiar tema" title="Modo oscuro"><%- include('icon', { name: 'moon' }) %></button>
      <a href="/admin/seguridad" class="admin-username-link" title="Seguridad: <%= admin.username %>"><%= admin.username %></a>
      <form id="admin-logout-form" action="/admin/logout" method="post" class="admin-logout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="link-button logout-btn" type="submit">Salir</button>
      </form>
    </div>
  </div>

  <nav class="admin-nav" aria-label="Administración">
    <a href="/admin" class="nav-item <%= typeof activeNav !== 'undefined' && activeNav === 'operacion' ? 'active' : '' %>">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span>Operación</span>
    </a>
    <a href="/" class="nav-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      <span>Reservar</span>
    </a>

    <!-- Direct links for desktop -->
    <a href="/admin/estadisticas" class="nav-item nav-desktop-only <%= typeof activeNav !== 'undefined' && activeNav === 'estadisticas' ? 'active' : '' %>">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      <span>Estadísticas</span>
    </a>
    <a href="/admin/clientes" class="nav-item nav-desktop-only <%= typeof activeNav !== 'undefined' && activeNav === 'clientes' ? 'active' : '' %>">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span>Clientes</span>
    </a>
    <a href="/admin/servicios" class="nav-item nav-desktop-only <%= typeof activeNav !== 'undefined' && activeNav === 'servicios' ? 'active' : '' %>">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      <span>Servicios</span>
    </a>
    <a href="/admin/capacidad" class="nav-item nav-desktop-only <%= typeof activeNav !== 'undefined' && activeNav === 'capacidad' ? 'active' : '' %>">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Capacidad</span>
    </a>

    <!-- Mobile "Más" disclosure menu -->
    <details class="admin-nav-more nav-mobile-only" id="admin-nav-more-details">
      <summary class="nav-item nav-more-summary" aria-haspopup="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
        <span>Más ▾</span>
      </summary>
      <div class="admin-nav-more-dropdown">
        <a href="/admin/estadisticas" class="dropdown-link <%= typeof activeNav !== 'undefined' && activeNav === 'estadisticas' ? 'active' : '' %>">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          <span>Estadísticas</span>
        </a>
        <a href="/admin/clientes" class="dropdown-link <%= typeof activeNav !== 'undefined' && activeNav === 'clientes' ? 'active' : '' %>">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          <span>Clientes</span>
        </a>
        <a href="/admin/servicios" class="dropdown-link <%= typeof activeNav !== 'undefined' && activeNav === 'servicios' ? 'active' : '' %>">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span>Servicios</span>
        </a>
        <a href="/admin/capacidad" class="dropdown-link <%= typeof activeNav !== 'undefined' && activeNav === 'capacidad' ? 'active' : '' %>">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Capacidad</span>
        </a>
        <a href="/admin/seguridad" class="dropdown-link <%= typeof activeNav !== 'undefined' && activeNav === 'seguridad' ? 'active' : '' %>">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Seguridad</span>
        </a>
        <div class="dropdown-divider"></div>
        <button type="submit" form="admin-logout-form" class="dropdown-link dropdown-logout-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </details>
  </nav>
</header>

<!-- Modal global para mostrar los códigos QR de Yape (Hugo y Roxana) - Versión Extra Grande -->
<style>
  .qr-modal-backdrop {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 999999 !important;
    background: rgba(5, 8, 16, 0.88) !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    display: none;
    align-items: center !important;
    justify-content: center !important;
    padding: 10px !important;
    box-sizing: border-box !important;
    animation: qrBackdropFade 0.2s ease-out;
  }
  .qr-modal-container {
    position: relative !important;
    background: #ffffff !important;
    color: #0f172a !important;
    width: 96vw !important;
    max-width: 460px !important;
    max-height: 96vh !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch !important;
    border-radius: 22px !important;
    padding: 16px 14px 14px 14px !important;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    box-sizing: border-box !important;
    transition: max-width 0.2s ease;
  }
  .qr-modal-close-btn {
    position: absolute !important;
    top: 10px !important;
    right: 12px !important;
    width: 42px !important;
    height: 42px !important;
    border-radius: 50% !important;
    border: none !important;
    background: #f1f5f9 !important;
    color: #334155 !important;
    font-size: 1.7rem !important;
    line-height: 1 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    touch-action: manipulation !important;
    z-index: 5 !important;
  }
  .qr-modal-header {
    text-align: center !important;
    margin-bottom: 8px !important;
    width: 100% !important;
    padding-right: 36px !important;
    box-sizing: border-box !important;
  }
  .qr-yape-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
    padding: 3px 12px !important;
    background: #742284 !important;
    color: #ffffff !important;
    border-radius: 20px !important;
    font-size: 0.8rem !important;
    font-weight: 700 !important;
    margin-bottom: 2px !important;
  }
  .qr-modal-title {
    margin: 2px 0 0 0 !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #742284 !important;
  }
  .qr-owner-pill {
    margin-top: 3px !important;
    font-size: 0.88rem !important;
    color: #475569 !important;
    font-weight: 600 !important;
  }
  .qr-owner-pill strong {
    color: #0f172a !important;
    font-weight: 800 !important;
  }
  .qr-modal-image-wrapper {
    position: relative !important;
    background: #742284 !important;
    padding: 6px !important;
    border-radius: 18px !important;
    box-shadow: 0 8px 30px rgba(116, 34, 132, 0.35) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 8px 0 10px 0 !important;
    width: 100% !important;
    max-width: 410px !important;
    box-sizing: border-box !important;
    cursor: zoom-in !important;
  }
  .qr-modal-img {
    width: 100% !important;
    height: auto !important;
    max-height: 65vh !important;
    display: block !important;
    border-radius: 12px !important;
    background: #ffffff !important;
    object-fit: contain !important;
    transition: transform 0.2s ease;
  }
  .qr-zoom-badge {
    margin-top: 6px !important;
    font-size: 0.75rem !important;
    color: #f1d7f8 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    font-weight: 600 !important;
  }
  /* Modo pantalla completa / zoom máximo */
  .qr-modal-container.is-max-zoom {
    max-width: 98vw !important;
    max-height: 98vh !important;
    padding: 10px !important;
  }
  .qr-modal-container.is-max-zoom .qr-modal-image-wrapper {
    max-width: 100% !important;
    margin: 4px 0 !important;
    cursor: zoom-out !important;
  }
  .qr-modal-container.is-max-zoom .qr-modal-img {
    max-height: 80vh !important;
  }
  .qr-modal-container.is-max-zoom .qr-owner-pill {
    display: none !important;
  }
  .qr-modal-actions {
    display: flex !important;
    gap: 8px !important;
    width: 100% !important;
    max-width: 410px !important;
    margin-top: 4px !important;
  }
  .qr-action-btn {
    flex: 1 !important;
    padding: 11px 8px !important;
    border-radius: 12px !important;
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    text-align: center !important;
    text-decoration: none !important;
    cursor: pointer !important;
    touch-action: manipulation !important;
    border: none !important;
    box-sizing: border-box !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 4px !important;
  }
  .qr-action-btn.btn-zoom {
    background: #fdf4ff !important;
    color: #742284 !important;
    border: 1.5px solid #d8b4fe !important;
  }
  .qr-action-btn.btn-secondary {
    background: #f1f5f9 !important;
    color: #334155 !important;
  }
  .qr-action-btn.btn-primary {
    background: #742284 !important;
    color: #ffffff !important;
  }
  [data-open-qr] * {
    pointer-events: none !important;
  }
  [data-open-qr] {
    cursor: pointer !important;
    touch-action: manipulation !important;
    -webkit-tap-highlight-color: transparent !important;
  }
  /* Modo oscuro */
  [data-theme="dark"] .qr-modal-container {
    background: #0f172a !important;
    color: #f8fafc !important;
    border: 1px solid #334155 !important;
  }
  [data-theme="dark"] .qr-modal-close-btn {
    background: #1e293b !important;
    color: #cbd5e1 !important;
  }
  [data-theme="dark"] .qr-owner-pill {
    color: #94a3b8 !important;
  }
  [data-theme="dark"] .qr-owner-pill strong {
    color: #f8fafc !important;
  }
  [data-theme="dark"] .qr-action-btn.btn-zoom {
    background: #2e1065 !important;
    color: #e9d5ff !important;
    border-color: #7e22ce !important;
  }
  [data-theme="dark"] .qr-action-btn.btn-secondary {
    background: #1e293b !important;
    color: #e2e8f0 !important;
  }
</style>

<div id="yape-qr-modal" class="qr-modal-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="qr-modal-title">
  <div class="qr-modal-container" id="qr-modal-container">
    <button type="button" class="qr-modal-close-btn" id="qr-modal-close" onclick="closeYapeQr()" aria-label="Cerrar">&times;</button>
    
    <div class="qr-modal-header">
      <div class="qr-yape-badge">
        <span>🟣</span>
        <span>Yape Oficial</span>
      </div>
      <h3 id="qr-modal-title" class="qr-modal-title">Pagar a Hugo</h3>
      <div class="qr-owner-pill">
        Titular: <strong id="qr-modal-owner-name">Hugo Heber Velasquez Ayala</strong>
      </div>
    </div>

    <div class="qr-modal-image-wrapper" id="qr-image-wrapper" onclick="toggleYapeQrZoom()" title="Toca para agrandar / pantalla completa">
      <img id="qr-modal-img" src="/public/img/qr-hugo.jpg" alt="Código QR de Yape" class="qr-modal-img" loading="eager">
      <span class="qr-zoom-badge" id="qr-zoom-badge">🔍 Toca la imagen para pantalla completa</span>
    </div>

    <div class="qr-modal-actions">
      <button type="button" class="qr-action-btn btn-zoom" id="qr-zoom-btn" onclick="toggleYapeQrZoom()">
        🔍 <span id="qr-zoom-btn-text">Agrandar</span>
      </button>
      <a id="qr-modal-download" href="/public/img/qr-hugo.jpg" download="yape-qr.jpg" class="qr-action-btn btn-secondary">
        💾 Guardar
      </a>
      <button type="button" class="qr-action-btn btn-primary" id="qr-modal-done" onclick="closeYapeQr()">
        Listo, cerrar
      </button>
    </div>
  </div>
</div>

<script>
  (() => {
    const qrData = {
      hugo: {
        name: 'Hugo Heber Velasquez Ayala',
        file: '/public/img/qr-hugo.jpg',
        title: 'Pagar a Hugo',
        download: 'yape-hugo-velasquez.jpg'
      },
      roxana: {
        name: 'Roxana Pilar Perez Lopez',
        file: '/public/img/qr-roxana.jpg',
        title: 'Pagar a Roxana',
        download: 'yape-roxana-perez.jpg'
      }
    };

    let isZoomed = false;

    window.openYapeQr = function(target) {
      const modal = document.getElementById('yape-qr-modal');
      const container = document.getElementById('qr-modal-container');
      if (!modal) return;
      isZoomed = false;
      if (container) container.classList.remove('is-max-zoom');
      updateZoomButton();

      const data = qrData[target] || qrData.hugo;
      const img = document.getElementById('qr-modal-img');
      const title = document.getElementById('qr-modal-title');
      const ownerName = document.getElementById('qr-modal-owner-name');
      const downloadBtn = document.getElementById('qr-modal-download');

      if (img) img.src = data.file;
      if (title) title.textContent = data.title;
      if (ownerName) ownerName.textContent = data.name;
      if (downloadBtn) {
        downloadBtn.href = data.file;
        downloadBtn.download = data.download;
      }
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    };

    window.closeYapeQr = function() {
      const modal = document.getElementById('yape-qr-modal');
      const container = document.getElementById('qr-modal-container');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
      if (container) container.classList.remove('is-max-zoom');
      isZoomed = false;
      updateZoomButton();
    };

    window.toggleYapeQrZoom = function() {
      const container = document.getElementById('qr-modal-container');
      if (!container) return;
      isZoomed = !isZoomed;
      container.classList.toggle('is-max-zoom', isZoomed);
      updateZoomButton();
    };

    function updateZoomButton() {
      const btnText = document.getElementById('qr-zoom-btn-text');
      const badge = document.getElementById('qr-zoom-badge');
      if (btnText) btnText.textContent = isZoomed ? 'Normal' : 'Agrandar';
      if (badge) badge.textContent = isZoomed ? '🔍 Toca para tamaño normal' : '🔍 Toca para pantalla completa';
    }

    function handleEvent(e) {
      const btn = e.target && e.target.closest ? e.target.closest('[data-open-qr]') : null;
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        const target = btn.getAttribute('data-open-qr');
        window.openYapeQr(target);
      }
    }

    document.addEventListener('click', handleEvent, { passive: false });
    document.addEventListener('touchend', handleEvent, { passive: false });

    const modal = document.getElementById('yape-qr-modal');
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) window.closeYapeQr();
      });
      modal.addEventListener('touchend', (e) => {
        if (e.target === modal) {
          e.preventDefault();
          window.closeYapeQr();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') window.closeYapeQr();
    });
  })();
</script>
